[mysqld]
# Character set — Ghost requires utf8mb4
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# InnoDB tuning for Ghost workload (mostly reads)
innodb_buffer_pool_size        = 256M   # Increase to 512M+ if VPS has 8GB RAM
innodb_log_file_size           = 64M
innodb_flush_log_at_trx_commit = 2      # Performance over strict durability
innodb_flush_method            = O_DIRECT

# Connection handling
max_connections                = 50     # Ghost doesn't need many connections
wait_timeout                   = 600
interactive_timeout            = 600

# Query cache (disabled in MySQL 8+, remove if using older version)
# query_cache_type = 0

# Binary log for point-in-time recovery (optional, uses disk space)
# log_bin        = /var/lib/mysql/mysql-bin
# expire_logs_days = 7

# Slow query log
slow_query_log         = 1
slow_query_log_file    = /var/lib/mysql/slow.log
long_query_time        = 2

[client]
default-character-set = utf8mb4
