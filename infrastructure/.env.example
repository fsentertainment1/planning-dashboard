# ============================================================
# NullPoint / Pro Audio Platform — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# --- Ghost ---
GHOST_URL=https://nullpoint.pro
GHOST_VERSION=5                         # Uses latest Ghost 5.x from DockerHub (built from github.com/TryGhost/Ghost)

# --- Database ---
MYSQL_ROOT_PASSWORD=change_me_strong_root_pass
MYSQL_DATABASE=ghost_prod
MYSQL_USER=ghost
MYSQL_PASSWORD=change_me_strong_ghost_pass

# --- Mail (Mailgun) ---
MAILGUN_SMTP_HOST=smtp.mailgun.org
MAILGUN_SMTP_PORT=587
MAILGUN_SMTP_USER=postmaster@mg.nullpoint.pro
MAILGUN_SMTP_PASS=your-mailgun-smtp-password
MAIL_FROM=hello@nullpoint.pro

# --- Object Storage (Cloudflare R2 or any S3-compatible) ---
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key
S3_BUCKET=nullpoint-media
S3_REGION=auto
# Cloudflare R2 endpoint:
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Or Hetzner Object Storage:
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_PATH_STYLE=true

# --- Stripe (for Ghost memberships) ---
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Backups ---
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=nullpoint-backups
BACKUP_S3_ACCESS_KEY=your-backup-key
BACKUP_S3_SECRET_KEY=your-backup-secret
BACKUP_RETENTION_DAYS=30

# --- Caddy ---
ACME_EMAIL=admin@nullpoint.pro
DOMAIN=nullpoint.pro
