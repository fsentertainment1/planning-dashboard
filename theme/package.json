{
  "name": "nullpoint",
  "description": "NullPoint — Pro Audio Engineering Platform Ghost Theme",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "keywords": ["ghost-theme", "pro-audio", "engineering", "dark"],
  "config": {
    "posts_per_page": 18,
    "image_sizes": {
      "xxs": { "width": 30 },
      "xs":  { "width": 100 },
      "s":   { "width": 300 },
      "m":   { "width": 600 },
      "l":   { "width": 1000 },
      "xl":  { "width": 2000 }
    },
    "card_assets": true,
    "custom": {
      "navigation_layout": {
        "type":    "select",
        "options": ["Logo on left", "Logo in the middle"],
        "default": "Logo on left"
      },
      "header_style": {
        "type":    "select",
        "options": ["Dark solid", "Dark blur", "Terminal"],
        "default": "Dark solid"
      },
      "show_publication_cover": {
        "type":    "boolean",
        "default": false
      }
    }
  }
}
